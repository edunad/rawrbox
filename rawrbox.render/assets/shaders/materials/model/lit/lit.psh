#include "camera.fxh"
#include "colormap.fxh"
#include "correction.fxh"
#include "decal_uniforms.fxh"
#include "defines.fxh"
#include "light_uniforms.fxh"
#include "math.fxh"
#include "pixel_bindless_uniforms.fxh"
#include "unpack.fxh"

#define READ_LIGHTS
#define READ_DECALS
#define READ_TILES
#include "binning.fxh"

Texture2DArray g_Textures[];
SamplerState g_Sampler;

#include "decaling.fxh"
#include "lighting.fxh"
#include "noise.fxh"

struct PSInput {
	float4 Pos : SV_POSITION;
	float3 WorldPos : POSITION1;

	float3 Normal : NORMAL;
	float4 Tangent : TANGENT;

	float2 UV : TEX_COORD;

	nointerpolation uint3 Data : DATA; // Color (RGBA8) + GPU id (ABGR8) + texture
};

struct PSOutput {
	float4 Color : SV_TARGET0;
	float4 GPUPick : SV_TARGET1;
};

float3x3 CreateTangentToWorld(float3 normal, float4 tangent) {
	float3 T = tangent.xyz;
	float3 B = cross(normal, T) * tangent.w;

	float3x3 TBN = float3x3(T, B, normal);
	return TBN;
}

// DEBUG -----
#define DEBUG_MAX_LIGHTS 32.0

// Heatmap
float3 GetLightDebugColor(float2 pixel, uint tileIndex, uint zbin) {
	uint2 range = UnpackZBin(LightZBins[zbin]);
	uint count = 0;

	for (uint bin = range.x / BIN_BITS; bin <= range.y / BIN_BITS; ++bin) {
		count += countbits(LightTiles[tileIndex * LIGHT_BINS + bin] & GetBinMask(bin, range));
	}

	return count == 0 ? float3(0.02, 0.02, 0.02) : turboColormap(saturate(float(count) / DEBUG_MAX_LIGHTS));
}
// -----------

// Unpacks a 2 channel BC5 normal to xyz
float3 UnpackBC5Normal(float2 packedNormal) {
	return float3(packedNormal, sqrt(1 - saturate(dot(packedNormal.xy, packedNormal.xy))));
}

float3 TangentSpaceNormalMapping(float3 sampledNormal, float3x3 TBN) {
	float3 normal = UnpackBC5Normal(sampledNormal.xy);
	normal.xy = sampledNormal.xy * 2.0f - 1.0f;
	normal = normalize(normal);

	return mul(normal, TBN);
}

void main(in PSInput PSIn, out PSOutput PSOut) {
	float4 vertColor = Unpack_RGBA8_UNORM(PSIn.Data.x);
	uint texIndex = PSIn.Data.z;

	float4 baseColor = g_Textures[BaseID].Sample(g_Sampler, float3(PSIn.UV, texIndex)) * vertColor;

	// Remove alpha ----
	clip(baseColor.a - AlphaCutoff);
	// -------------

	if (LIGHT_DEBUG != 0) {
		PSOut.Color = float4(GetLightDebugColor(PSIn.Pos.xy, GetTileIndex(PSIn.Pos.xy), GetZBin(PSIn.Pos.w)), 1.0);
	} else if (TOTAL_DECALS != 0 || TOTAL_LIGHTS != 0) {
		uint tileIndex = GetTileIndex(PSIn.Pos.xy);
		uint zbin = GetZBin(PSIn.Pos.w);

		// DECALS -----
		if (TOTAL_DECALS != 0) {
			float3 ddxPos = ddx(PSIn.WorldPos);
			float3 ddyPos = ddy(PSIn.WorldPos);

			float4 roughtness = 0; // TODO
			uint2 range = UnpackZBin(DecalZBins[zbin]);

			for (uint bin = range.x / BIN_BITS; bin <= range.y / BIN_BITS; ++bin) {
				uint mask = DecalTiles[tileIndex * DECAL_BINS + bin] & GetBinMask(bin, range);
				ApplyDecals(mask, bin, float4(PSIn.WorldPos, 1.0), ddxPos, ddyPos, baseColor, roughtness);
			}
		}
		// -------------

		// NORMAL -----
		float3 normalTS = g_Textures[NormalID].Sample(g_Sampler, float3(PSIn.UV, texIndex)).rgb;
		float3x3 TBN = CreateTangentToWorld(PSIn.Normal, PSIn.Tangent);
		float3 normal = TangentSpaceNormalMapping(normalTS, TBN);
		// -------------

		// ROUGHT / METAL -----
		float2 roughtMetalTS = g_Textures[RoughtMetalID].Sample(g_Sampler, float3(PSIn.UV, texIndex)).bg;

		float metal = MetalnessFactor;
		float rough = RoughnessFactor;

		if (roughtMetalTS.x != 0.0 && roughtMetalTS.y != 0.0) {
			metal *= roughtMetalTS.x;
			rough *= roughtMetalTS.y;
		}
		// -------------

		float4 emissionTS = g_Textures[EmissionID].Sample(g_Sampler, float3(PSIn.UV, texIndex)) * vertColor;

		// LINEAR ------
		// Textures + colors -> sRGB
		float3 albedo = toLinear(baseColor.rgb);
		float3 emission = toLinear(emissionTS.rgb);
		// -------------

		// LIGHT ------
		float3 diffuse = ComputeDiffuseColor(albedo, metal);
		float3 specular = ComputeF0(SpecularFactor, albedo, metal);

		LightResult result = (LightResult)0;

		if (FULL_BRIGHT == 0) {
			result.Diffuse = diffuse; // FULL BRIGHT
		} else {
			float3 V = normalize(Camera.pos - PSIn.WorldPos);
			float dither = InterleavedGradientNoise(PSIn.Pos.xy);

			// Directional ----
			for (uint index = 0; index < TOTAL_DIRECTIONAL_LIGHTS; ++index) {
				ApplyLight(index, result, specular, rough, diffuse, normal, V, PSIn.WorldPos, dither);
			}
			// -------------------------

			uint2 range = UnpackZBin(LightZBins[zbin]);
			for (uint bin = range.x / BIN_BITS; bin <= range.y / BIN_BITS; ++bin) {
				uint mask = LightTiles[tileIndex * LIGHT_BINS + bin] & GetBinMask(bin, range);
				ApplyLights(mask, bin, result, specular, rough, diffuse, normal, V, PSIn.WorldPos, dither);
			}

			result.Diffuse += diffuse * LightConstants.ambientColor.rgb; // AMBIENT
		}
		// ----------------

		float3 outRadiance = 0;
		outRadiance += result.Diffuse + result.Specular;
		outRadiance += emission * EmissionFactor;
		// ------------

		PSOut.Color.rgb = toSRGB(saturate(outRadiance));
		PSOut.Color.a = baseColor.a;
	} else {
		PSOut.Color = baseColor;
	}

	// GPU PICKING -----
	float4 gpuId = Unpack_ABGR8_UNORM(PSIn.Data.y);
	PSOut.GPUPick = float4(gpuId.rgb, all(gpuId.rgb) ? 0. : 1.);
	// -----------------
}
