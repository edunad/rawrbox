#include "pixel_bindless_uniforms.fxh"
#include "shadow_uniforms.fxh"

StructuredBuffer<uint> ShadowPageTable;

Texture2DArray g_Textures[];
SamplerState g_Sampler;

RWTexture2DArray<uint> ShadowPoolRW;
RWStructuredBuffer<uint> ShadowTouched;

struct PSInput {
	float4 Pos : SV_POSITION;
	float3 Dir : POSITION1;
	float2 UV : TEX_COORD;

	nointerpolation uint View : VIEW;
};

void main(in PSInput PSIn) {
	if (AlphaCutoff > 0.0 && g_Textures[BaseID].Sample(g_Sampler, float3(PSIn.UV, GetShadowViewSlice(PSIn.View))).a < AlphaCutoff) discard;

	uint view = PSIn.View;
	uint mip = GetShadowViewMip(view);
	uint layer = GetShadowViewLayer(view);

	uint2 texel = uint2(PSIn.Pos.xy);
	if (any(texel >= (SHADOW_VIRTUAL_SIZE >> mip))) return;

	uint slot = GetShadowViewSlot(view);
	uint face = GetShadowViewFace(view);
	uint2 page = texel / SHADOW_PAGE_SIZE;

	uint entry = ShadowPageTable[GetShadowEntry(slot, face, mip, mip == 0u ? GetShadowTablePage(slot, face, page) : page)];
	if ((entry & SHADOW_ALLOCATED) == 0u) return;
	if (layer == SHADOW_LAYER_STATIC && (entry & SHADOW_DRAW) == 0u) return;

	uint phys = entry & SHADOW_PHYS_MASK;
	InterlockedMin(ShadowPoolRW[uint3(GetShadowPhysTexel(phys, texel % SHADOW_PAGE_SIZE), layer)], asuint(length(PSIn.Dir)));
	
	if (layer == SHADOW_LAYER_DYNAMIC && ShadowTouched[phys] == 0u) ShadowTouched[phys] = 1u;
}